# Apple's full-frame-rate playback intent is an integer in the movie-level mdta metadata.
# ExifTool's built-in tag defaults to a UTF-8 string, so declare the native int64 type.
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::QuickTime::Keys' => {
        'full-frame-rate-playback-intent' => {
            Name => 'FullFrameRatePlaybackIntent',
            Writable => 'int64s',
        },
    },
);
1;
